#include <Wire.h>

#define MPU 0x68

int16_t AcX, AcY, AcZ;

float Ax, Ay, Az;
float accMagnitude;

int stepCount = 0;
bool stepDetected = false;

float threshold = 1.2;  // Ajustable (importante)

unsigned long lastStepTime = 0;
unsigned long stepDelay = 300; // ms entre pasos

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);

  // Inicializar MPU6050
  Wire.beginTransmission(MPU);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();

  Serial.println("Contador de pasos listo!");
}

void loop() {
  // Leer acelerómetro
  Wire.beginTransmission(MPU);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU, 6, true);

  AcX = Wire.read() << 8 | Wire.read();
  AcY = Wire.read() << 8 | Wire.read();
  AcZ = Wire.read() << 8 | Wire.read();

  // Convertir a g
  Ax = AcX / 16384.0;
  Ay = AcY / 16384.0;
  Az = AcZ / 16384.0;

  // Magnitud total
  accMagnitude = sqrt(Ax*Ax + Ay*Ay + Az*Az);

  // Detección de paso
  if (accMagnitude > threshold && !stepDetected) {
    if (millis() - lastStepTime > stepDelay) {
      stepCount++;
      stepDetected = true;
      lastStepTime = millis();

      Serial.print("Paso: ");
      Serial.println(stepCount);
    }
  }

  // Reset de detección
  if (accMagnitude < threshold) {
    stepDetected = false;
  }

  delay(50);
}
