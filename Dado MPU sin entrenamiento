#include <Wire.h>
#include <MPU6050.h>

MPU6050 mpu;

float angleX = 0, angleY = 0, angleZ = 0;
unsigned long lastTime = 0;
int currentFace = 0;
unsigned long faceStartTime = 0;
const float TARGET = 90.0;
const float TOL = 20.0;

void setup() {
  Serial.begin(9600);
  Wire.begin();
  mpu.initialize();
  mpu.setFullScaleGyroRange(MPU6050_GYRO_FS_250);
  lastTime = micros();
  faceStartTime = millis();
  Serial.println("Dado iniciado");
}

void loop() {
  int16_t gx, gy, gz;
  mpu.getRotation(&gx, &gy, &gz);
  
  float gyroX = gx / 131.0;
  float gyroY = gy / 131.0;
  float gyroZ = gz / 131.0;
  
  unsigned long now = micros();
  float dt = (now - lastTime) / 1000000.0;
  lastTime = now;
  
  if (dt > 0 && dt < 0.05) {
    angleX += gyroX * dt;
    angleY += gyroY * dt;
    angleZ += gyroZ * dt;
    
    if (angleX >= 360) angleX -= 360;
    if (angleX < 0) angleX += 360;
    if (angleY >= 360) angleY -= 360;
    if (angleY < 0) angleY += 360;
    if (angleZ >= 360) angleZ -= 360;
    if (angleZ < 0) angleZ += 360;
  }
  
  int newFace = 0;
  
  if ((angleZ < TOL) || (angleZ > 360 - TOL)) newFace = 1;
  else if (abs(angleZ - TARGET) < TOL) newFace = 6;
  else if ((angleX < TOL) || (angleX > 360 - TOL)) newFace = 2;
  else if (abs(angleX - TARGET) < TOL) newFace = 5;
  else if ((angleY < TOL) || (angleY > 360 - TOL)) newFace = 3;
  else if (abs(angleY - TARGET) < TOL) newFace = 4;
  
  if (newFace != 0 && newFace != currentFace) {
    if (currentFace != 0) {
      unsigned long duration = millis() - faceStartTime;
      Serial.print(currentFace);
      Serial.print(":");
      Serial.print(duration);
      Serial.println("ms");
    }
    currentFace = newFace;
    faceStartTime = millis();
  }
  
  delay(20);
}
